  "private": true,
  "description": "Personal React component library with calm motion. Forked from Arc Library (MIT); full free set of 116 components and 22 blocks.",
  "license": "MIT",
  "author": "gyb-cpu",
  "homepage": "https://github.com/gyb-cpu/still-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyb-cpu/still-ui.git"
  },
