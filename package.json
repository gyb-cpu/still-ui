  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:registry": "node scripts/check-registry.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:docs": "node scripts/build-docs.mjs",
